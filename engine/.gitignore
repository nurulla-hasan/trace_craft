# ==========================================
# Python Engine .gitignore
# ==========================================

# Virtual environment
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linters
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Local Environment
.env
.env.*
!.env.example

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Diagnostic test artifacts (keep .gitkeep if needed)
test_outputs/*.png
test_outputs/*.svg
!test_outputs/.gitkeep
