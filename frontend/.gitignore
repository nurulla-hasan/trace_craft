# ==========================================
# Frontend .gitignore
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
coverage/

# Next.js build
.next/
out/
build/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Misc / Agent artifacts
.DS_Store
*.pem
Thumbs.db
.vscode/
.idea/
.agents
tasks
.qoder
