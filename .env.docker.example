# Copy this file to .env on your VPS before running `docker compose up -d --build`
# Replace YOUR_VPS_IP with your actual VPS public IP address!

# Host ports (chosen to avoid conflicts on your VPS)
FRONTEND_PORT=3010
BACKEND_PORT=5010

# Keep 'development' while accessing via http://YOUR_VPS_IP:3010 (no HTTPS yet),
# otherwise browsers will reject Secure cookies. Switch to 'production' after adding HTTPS/domain.
BACKEND_NODE_ENV=development

# URLs (Update YOUR_VPS_IP!)
FRONTEND_URL=http://YOUR_VPS_IP:3010
NEXT_PUBLIC_API_BASE_URL=http://YOUR_VPS_IP:5010/api/v1

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_strong_postgres_password
POSTGRES_DB=tracecraft_db

# JWT Secrets (generate strong 32+ char random strings, e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace-with-32-plus-char-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-32-plus-char-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Default Admin Account
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Optional: SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER=TraceCraft <no-reply@example.com>

# Optional: Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://YOUR_VPS_IP:5010/api/v1/auth/google/callback

# Optional: Local Payments
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=
PAYMENT_ROCKET_NUMBER=
